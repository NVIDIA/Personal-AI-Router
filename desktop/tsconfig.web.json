{
    "$schema": "https://json.schemastore.org/tsconfig",
    "extends": ["@electron-toolkit/tsconfig/tsconfig.web.json", "./tsconfig.paths.json"],
    "include": [
        "src/ui/**/*",
        "src/shared/**/*",
        "src/preload/api/**/*.ts",
        "src/preload/*.d.ts",
        "vite.renderer.config.ts"
    ],
    "exclude": ["src/electron/**"],
    "compilerOptions": {
        "composite": true,
        "moduleResolution": "bundler",
        "jsx": "react-jsx"
    }
}

{
    "$schema": "https://json.schemastore.org/tsconfig",
    "extends": ["@electron-toolkit/tsconfig/tsconfig.node.json", "./tsconfig.paths.json"],
    "include": [
        "electron.vite.config.*",
        "vite.renderer.config.*",
        "src/electron/**/*",
        "src/preload/**/*",
        "src/shared/**/*",
        "electron-builder.config.ts",
        "scripts/windows-sign.js",
        "scripts/**/*.ts"
    ],
    "exclude": ["src/ui/**"],
    "compilerOptions": {
        "composite": true,
        "moduleResolution": "bundler",
        "types": ["node"]
    }
}

# Editor defaults. Line endings for installer scripts are enforced in Git via
# .gitattributes (*.sh, *.nsh → eol=lf). Run `npm run fix:build-scripts` after
# editing on Windows if your editor ignores EditorConfig.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{sh,nsh}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

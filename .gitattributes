# Windows-built packages must ship executable Unix shell scripts.
*.sh text eol=lf

# Engine Manager embeds these files with go:embed and pins their SHA-256, and
# Linux binaries are cross-compiled from Windows checkouts.
/services/nvpair-engine-manager/*.py text eol=lf
/services/nvpair-engine-manager/manifests/*.json text eol=lf
/services/nvpair-engine-manager/testdata/qwen38-runtime-recipe.json text eol=lf

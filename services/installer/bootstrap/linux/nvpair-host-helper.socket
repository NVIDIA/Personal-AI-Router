# Inert package input. nvpair-host-bootstrap replaces TARGET_GROUP only after a
# reviewed request, then writes the rendered unit to /etc/systemd/system.
[Unit]
Description=NVIDIA PAIR Host Helper Socket

[Socket]
ListenStream=/run/nvpair-host-helper.sock
SocketMode=0660
SocketUser=root
SocketGroup=TARGET_GROUP
RemoveOnStop=true

[Install]
WantedBy=sockets.target
